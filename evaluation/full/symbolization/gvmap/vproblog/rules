tt_string_candidate_refined(X0, X1, X2, F1, F2, I1, I2, dis(F1, F2)) :- agg_string_candidate_refined(X0, X1, X2, F1, I1), string_candidate_refined(X0, X1, X2, F2, I2), ~d_string_candidate_refined(I2), equiv(F1, F2).
string_candidate_refined(X0, X1, X2, D, I1) :- tt_string_candidate_refined(X0, X1, X2, F1, F2, I1, I2, D).
d_string_candidate_refined(I2) :- tt_string_candidate_refined(X0, X1, X2, F1, F2, I1, I2, D).
subsequent_string_candidate(X0, X1, F, I) :- agg_subsequent_string_candidate(X0, X1, F, I), ~subsequent_string_candidate(X0, X1, F2, I2).
tt_subsequent_string_candidate(X0, X1, F1, F2, I1, I2, dis(F1, F2)) :- agg_subsequent_string_candidate(X0, X1, F1, I1), subsequent_string_candidate(X0, X1, F2, I2), ~d_subsequent_string_candidate(I2), equiv(F1, F2).
subsequent_string_candidate(X0, X1, D, I1) :- tt_subsequent_string_candidate(X0, X1, F1, F2, I1, I2, D).
d_subsequent_string_candidate(I2) :- tt_subsequent_string_candidate(X0, X1, F1, F2, I1, I2, D).
symbolic_data(X0, X1, X2, F, I) :- agg_symbolic_data(X0, X1, X2, F, I), ~symbolic_data(X0, X1, X2, F2, I2).
tt_symbolic_data(X0, X1, X2, F1, F2, I1, I2, dis(F1, F2)) :- agg_symbolic_data(X0, X1, X2, F1, I1), symbolic_data(X0, X1, X2, F2, I2), ~d_symbolic_data(I2), equiv(F1, F2).
symbolic_data(X0, X1, X2, D, I1) :- tt_symbolic_data(X0, X1, X2, F1, F2, I1, I2, D).
d_symbolic_data(I2) :- tt_symbolic_data(X0, X1, X2, F1, F2, I1, I2, D).

// final
req_data_object(X0, X1, X2, F) :- data_object(X0, X1, X2, F, I), ~d_data_object(I).
req_labeled_ea(X0, F) :- labeled_ea(X0, F, I), ~d_labeled_ea(I).
req_symbolic_data(X0, X1, X2, F) :- symbolic_data(X0, X1, X2, F, I), ~d_symbolic_data(I).
