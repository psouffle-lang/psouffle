sumlist([], 0).
sumlist([X|Xs], S) :- sumlist(Xs, S1), S is X + S1.

data_object_candidate(EA, PTRSIZE, "symbol") :- address_in_data_refined(EA, _), pointer_size(PTRSIZE).
has_address_in_data_refined(EA) :- address_in_data_refined(EA, _).
data_object_candidate(EA, H_1, "string") :- string_candidate_refined(EA, END, _), H_1 is END - EA.
data_object_candidate(EA, SIZE, "other") :- preferred_data_access(EA, SIZE, _), SIZE < 16, \+has_address_in_data_refined(EA).
data_object_point(EA, SIZE, TYPE, -2, "data object bias") :- data_object_candidate(EA, SIZE, TYPE).
data_object_point(EA, PTRSIZE, "symbol", 5, "data access") :- data_object_candidate(EA, PTRSIZE, "symbol"), preferred_data_access(EA, PTRSIZE, _).
data_object_point(EA, PTRSIZE, "symbol", 3, "pointer array") :- data_object_candidate(EA, PTRSIZE, "symbol"), address_array(EA, _, _).
data_object_point(EA, PTRSIZE, "symbol", 2, "aligned") :- data_object_candidate(EA, PTRSIZE, "symbol"), EA mod PTRSIZE =:= 0.
data_object_point(EA, PTRSIZE, "symbol", -1, "overlaps string") :- data_object_candidate(EA, PTRSIZE, "symbol"), string_candidate_refined(STRBEG, STREND, _), STRBEG =< EA, EA < STREND.
data_object_point(EA, SIZE, "string", 2, "string basic point") :- data_object_candidate(EA, SIZE, "string").
data_object_point(EA, SIZE, "string", 3, "long string") :- data_object_candidate(EA, SIZE, "string"), SIZE > 5.
data_object_point(EA, SIZE, "string", 1, "string that has reference") :- data_object_candidate(EA, SIZE, "string"), may_have_symbolic_immediate(_, EA), data_limit(EA).
data_object_point(EA, SIZE, "string", 1, "string has string neighbors") :- data_object_candidate(EA, SIZE, "string"), subsequent_string_candidate(EA, _), subsequent_string_candidate(_, EA).
data_object_point(EA, SIZE, "other", 4, "data access") :- data_object_candidate(EA, SIZE, "other"), SIZE < 16.
data_object_conflict(EA, SIZE, TYPE, EA2, SIZE2, TYPE2) :- data_object_candidate(EA, SIZE, TYPE), data_object_candidate(EA2, SIZE2, TYPE2), EA2 > EA, EA2 < EA + SIZE.
data_object_conflict(EA, SIZE, TYPE, EA, SIZE2, TYPE2) :- data_object_candidate(EA, SIZE, TYPE), data_object_candidate(EA, SIZE2, TYPE2), SIZE2 > SIZE.
data_object_conflict(EA, SIZE, TYPE, EA, SIZE, TYPE2) :- data_object_candidate(EA, SIZE, TYPE), data_object_candidate(EA, SIZE, TYPE2), \+(TYPE = TYPE2).
data_object_total_points(EA, SIZE, TYPE, POINTS) :- data_object_candidate(EA, SIZE, TYPE), findall(X, (data_object_point(EA, SIZE, TYPE, X, _)), XS_1), sumlist(XS_1, POINTS).
discarded_data_object(EA, SIZE, TYPE) :- data_object_conflict(EA, SIZE, TYPE, EA2, SIZE2, TYPE2), data_object_total_points(EA, SIZE, TYPE, POINTS1), data_object_total_points(EA2, SIZE2, TYPE2, POINTS2), POINTS1 < POINTS2.
discarded_data_object(EA, SIZE, TYPE) :- data_object_conflict(EA2, SIZE2, TYPE2, EA, SIZE, TYPE), data_object_total_points(EA, SIZE, TYPE, POINTS1), data_object_total_points(EA2, SIZE2, TYPE2, POINTS2), POINTS1 < POINTS2.
data_object(EA, SIZE, TYPE) :- data_object_total_points(EA, SIZE, TYPE, POINTS), \+discarded_data_object(EA, SIZE, TYPE), POINTS >= 0.
symbolic_data(EA, SIZE, VAL) :- data_object(EA, SIZE, "symbol"), address_in_data_refined(EA, VAL).
labeled_ea(EA) :- symbolic_data(_, _, EA).
labeled_ea(EA) :- data_object(EA, _, "string").

query(data_object(_,_,_)).
query(symbolic_data(_,_,_)).
query(labeled_ea(_)).
