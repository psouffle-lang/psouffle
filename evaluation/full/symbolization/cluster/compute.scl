rel has_address_in_data_refined(v_ea) = address_in_data_refined(v_ea, _)
rel data_object_candidate(v_ea, v_h_1, "string") = string_candidate_refined(v_ea, v_end, _), v_h_1 == v_end - v_ea
rel data_object_candidate(v_ea, v_size, "other") = preferred_data_access(v_ea, v_size, _), v_size < 16, not has_address_in_data_refined(v_ea)
rel data_object_point(v_ea, v_size, v_type, -2, "data object bias") = data_object_candidate(v_ea, v_size, v_type)
rel data_object_point(v_ea, v_ptrsize, "symbol", 5, "data access") = data_object_candidate(v_ea, v_ptrsize, "symbol"), preferred_data_access(v_ea, v_ptrsize, _)
rel data_object_point(v_ea, v_ptrsize, "symbol", 3, "pointer array") = data_object_candidate(v_ea, v_ptrsize, "symbol"), address_array(v_ea, _, _)
rel data_object_point(v_ea, v_ptrsize, "symbol", 2, "aligned") = data_object_candidate(v_ea, v_ptrsize, "symbol"), v_ea  %  v_ptrsize == 0
rel data_object_point(v_ea, v_ptrsize, "symbol", -1, "overlaps string") = data_object_candidate(v_ea, v_ptrsize, "symbol"), string_candidate_refined(v_strbeg, v_strend, _), v_strbeg <= v_ea, v_ea < v_strend
rel data_object_point(v_ea, v_size, "string", 2, "string basic point") = data_object_candidate(v_ea, v_size, "string")
rel data_object_point(v_ea, v_size, "string", 3, "long string") = data_object_candidate(v_ea, v_size, "string"), v_size > 5
rel data_object_point(v_ea, v_size, "string", 1, "string that has reference") = data_object_candidate(v_ea, v_size, "string"), may_have_symbolic_immediate(_, v_ea), data_limit(v_ea)
rel data_object_point(v_ea, v_size, "string", 1, "string has string neighbors") = data_object_candidate(v_ea, v_size, "string"), subsequent_string_candidate(v_ea, _), subsequent_string_candidate(_, v_ea)
rel data_object_point(v_ea, v_size, "other", 4, "data access") = data_object_candidate(v_ea, v_size, "other"), v_size < 16
rel data_object_conflict(v_ea, v_size, v_type, v_ea2, v_size2, v_type2) = data_object_candidate(v_ea, v_size, v_type), data_object_candidate(v_ea2, v_size2, v_type2), v_ea2 > v_ea, v_ea2 < v_ea + v_size
rel data_object_conflict(v_ea, v_size, v_type, v_ea, v_size2, v_type2) = data_object_candidate(v_ea, v_size, v_type), data_object_candidate(v_ea, v_size2, v_type2), v_size2 > v_size
rel data_object_conflict(v_ea, v_size, v_type, v_ea, v_size, v_type2) = data_object_candidate(v_ea, v_size, v_type), data_object_candidate(v_ea, v_size, v_type2), v_type != v_type2
rel data_object_total_points(v_ea, v_size, v_type, v_points) = data_object_candidate(v_ea, v_size, v_type), v_points = sum[v_v_anon1](v_x: data_object_point(v_ea, v_size, v_type, v_x, v_v_anon1))
rel discarded_data_object(v_ea, v_size, v_type) = data_object_conflict(v_ea, v_size, v_type, v_ea2, v_size2, v_type2), data_object_total_points(v_ea, v_size, v_type, v_points1), data_object_total_points(v_ea2, v_size2, v_type2, v_points2), v_points1 < v_points2
rel discarded_data_object(v_ea, v_size, v_type) = data_object_conflict(v_ea2, v_size2, v_type2, v_ea, v_size, v_type), data_object_total_points(v_ea, v_size, v_type, v_points1), data_object_total_points(v_ea2, v_size2, v_type2, v_points2), v_points1 < v_points2
rel data_object(v_ea, v_size, v_type) = data_object_total_points(v_ea, v_size, v_type, v_points), not discarded_data_object(v_ea, v_size, v_type), v_points >= 0
rel symbolic_data(v_ea, v_size, v_val) = data_object(v_ea, v_size, "symbol"), address_in_data_refined(v_ea, v_val)
rel labeled_ea(v_ea) = symbolic_data(_, _, v_ea)
rel labeled_ea(v_ea) = data_object(v_ea, _, "string")
query data_object
query symbolic_data
query labeled_ea
