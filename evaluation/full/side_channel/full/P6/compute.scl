rel key_sensitive(v_from2) = key_sensitive(v_from1), assign(v_from2, v_from1)
rel key_ind(v_from2) = key_ind(v_from1), assign(v_from2, v_from1)
rel rand(v_from2) = rand(v_from1), assign(v_from2, v_from1)
rel equal_assign(v_from1, v_from2) = load_assign(v_from1, v_from2)
rel equal_assign(v_from1, v_from2) = store_assign(v_from1, v_from2)
rel equal_assign(v_from1, v_from2) = sext_assign(v_from1, v_from2)
rel equal_assign(v_from1, v_from2) = zext_assign(v_from1, v_from2)
rel equal_assign(v_from1, v_from2) = trunc_assign(v_from1, v_from2)
rel equal_assign(v_from1, v_from3) = equal_assign(v_from1, v_from2), equal_assign(v_from2, v_from3)
rel equal_assign(v_from2, v_from1) = equal_assign(v_from1, v_from2)
rel key_ind(v_from1) = constant(v_from1)
query key_ind
query key_sensitive
query hd_sensitive
query hd_sensitive_2
