xor_assign_left(X0, X1, D, I1) :- tt_xor_assign_left(X0, X1, F1, F2, I1, I2, D).
d_xor_assign_left(I2) :- tt_xor_assign_left(X0, X1, F1, F2, I1, I2, D).
xor_assign_right(X0, X1, F, I) :- agg_xor_assign_right(X0, X1, F, I), ~xor_assign_right(X0, X1, F2, I2).
tt_xor_assign_right(X0, X1, F1, F2, I1, I2, dis(F1, F2)) :- agg_xor_assign_right(X0, X1, F1, I1), xor_assign_right(X0, X1, F2, I2), ~d_xor_assign_right(I2), equiv(F1, F2).
xor_assign_right(X0, X1, D, I1) :- tt_xor_assign_right(X0, X1, F1, F2, I1, I2, D).
d_xor_assign_right(I2) :- tt_xor_assign_right(X0, X1, F1, F2, I1, I2, D).
zext_assign(X0, X1, F, I) :- agg_zext_assign(X0, X1, F, I), ~zext_assign(X0, X1, F2, I2).
tt_zext_assign(X0, X1, F1, F2, I1, I2, dis(F1, F2)) :- agg_zext_assign(X0, X1, F1, I1), zext_assign(X0, X1, F2, I2), ~d_zext_assign(I2), equiv(F1, F2).
zext_assign(X0, X1, D, I1) :- tt_zext_assign(X0, X1, F1, F2, I1, I2, D).
d_zext_assign(I2) :- tt_zext_assign(X0, X1, F1, F2, I1, I2, D).

// final
req_HD_SENSITIVE(X0, X1, F) :- HD_SENSITIVE(X0, X1, F, I), ~d_HD_SENSITIVE(I).
req_KEY_IND(X0, F) :- KEY_IND(X0, F, I), ~d_KEY_IND(I).
req_KEY_SENSITIVE(X0, F) :- KEY_SENSITIVE(X0, F, I), ~d_KEY_SENSITIVE(I).
