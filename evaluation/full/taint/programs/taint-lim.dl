.type Z = number
.type M = number
.type C = number
.type V = number
.type U = number
.type F = number
.type I = number
.type L = number
.type CL = number

.decl pt(c:C, v:V, o:C)
.input pt

.decl fpt(o1:C, f:F, o2:C)
.input fpt

.decl reachableCM(c:C, m:M)
.input reachableCM

.decl CICM(d:C, i:I, c:C, m:M)
.input CICM

.decl AssignPrim(v:U, u:U)
.input AssignPrim

.decl LoadPrim(y:U, x:V, f:F)
.input LoadPrim

.decl StorePrim(u:V, f:F, v:U)
.input StorePrim

.decl LoadStatPrim(y:U, f:F)
.input LoadStatPrim

.decl StoreStatPrim(f:F, v:U)
.input StoreStatPrim

.decl paramPrim(u:U, v:U, i:I)
.input paramPrim

.decl returnPrim(u:U, v:U, i:I)
.input returnPrim

.decl MU(m:M, u:U)
.input MU

.decl MV(m:M, v:V)
.input MV

.decl CCL(c:C, cl:CL)
.input CCL

.decl LCL(l:L, cl:CL)
.input LCL

.decl sinkCtxtLabel(l:CL)
.input sinkCtxtLabel

.decl srcCtxtLabel(l:CL)
.input srcCtxtLabel

.decl varInLabel(v:V, l:L)
.input varInLabel

.decl varInLabelPrim(v:U, l:L)
.input varInLabelPrim

.decl varOutLabel(v:V, l:L)
.input varOutLabel

.decl varOutLabelPrim(v:U, l:L)
.input varOutLabelPrim

.decl transferRefRef(u:V, v:V)
.input transferRefRef

.decl transferPrimRef(u:U, v:V)
.input transferPrimRef

.decl transferRefPrim(u:V, v:U)
.input transferRefPrim

.decl transferPrimPrim(u:U, v:U)
.input transferPrimPrim

.decl flowRefRef(u:V, v:V)
.input flowRefRef

.decl flowPrimRef(u:U, v:V)
.input flowPrimRef

.decl flowRefPrim(u:V, v:U)
.input flowRefPrim

.decl flowPrimPrim(u:U, v:U)
.input flowPrimPrim

.decl labelRef(c:C, v:V, l:CL)
.output labelRef

.decl labelPrim(c:C, u:U, l:CL)
.output labelPrim

.decl flow(src:CL, sink:CL)
.output flow

.decl lflow(src:L, sink:L)
.output lflow

.decl DUDU(c:C, u:U, d:C, v:U)

.decl transferObjRef(o:C, c:C, v:V)

.decl transferObjPrim(o:C, c:C, u:U)

.decl labelIn(o:C, l:CL)

.decl labelXferOut(o:C, l:CL)

.decl label(o:C, l:CL)
.output label

.decl labelPrimFld(o:C, f:F, l:CL)
.output labelPrimFld

.decl labelPrimFldStat(f:F, l:CL)
.output labelPrimFldStat

.decl sink(o:C, l:CL)
.output sink

.decl sinkPrim(c:C, u:U, l:CL)
.output sinkPrim

// Taint analysis, with support for nested taint
// - nested tainting: all fields
// - nested escaping: all fields
// - nested passthrough entry: only array elements
// - nested passthrough exit: only array elements
// - TODO: conditional escaping trigger entry: no nesting support
// - nested conditional escaping: all fields

// CONFIGURATION ===============================================================

// name=taint-lim

// .include "Z.dom"
// .include "M.dom"
// .include "C.dom"
// .include "V.dom"
// .include "U.dom"
// .include "F.dom"
// .include "I.dom"
// .include "L.dom"
// .include "CL.dom"

// .bddvarorder L0_L1_M0_CL0xCL1_C0_C1_V0xV1_U0xU1_F0_I0

// INPUT RELATIONS =============================================================

// c is a context of method m

// v = u
// y = x.f
// u.f = v
// y = f
// f = v

// u: formal param, v: actual arg, i: invocation stmt
// u: lhs at callsite, v: return var, i: invocation stmt

// u is a prim type variable in m
// v is a ref type variable in m






// OUTPUT RELATIONS ============================================================

// (c,v) is labeled with l
// (c,u) is labeled with l

// INTERMEDIATE RELATIONS ======================================================

// flowRefRef(u:V,v:V)
// flowPrimRef(u:U,v:V)
// flowRefPrim(u:V,v:U)
// flowPrimPrim(u:U,v:U)


// l inductively reaches o from a directly-labeled value
// l inductively reaches o from a value tainted by a passthrough
// o is labeled with l

// prim fld f of object o is labeled l
// static field f of primitive type has label l

// o escapes into sink l
// (c,u) escapes into sink l

// RULES =======================================================================

// (backward) escape flow

// abstract objects
// base escaping objects
0.999000::sink(o,cl) :- varOutLabel(v,l), MV(m,v), reachableCM(c,m), pt(c,v,o), CCL(c,cl), LCL(l,cl).
// conditional escaping
0.999000::sink(o,l)  :- pt(c,u,o), flowRefRef(u,v), labelRef(c,v,l), sinkCtxtLabel(l).
0.999000::sink(o,l)  :- pt(c,u,o), flowRefPrim(u,v), labelPrim(c,v,l), sinkCtxtLabel(l).
// nested escaping (regular and conditional)
0.999000::sink(o2,l) :- sink(o1,l), fpt(o1,t1,o2).

// primitive-type variables/fields
// base escaping variables
0.999000::sinkPrim(c,u,cl) :- varOutLabelPrim(u,l), reachableCM(c,m), MU(m,u), LCL(l,cl), CCL(c,cl).
// conditional escaping
0.999000::sinkPrim(c,u,l) :- flowPrimRef(u,v), labelRef(c,v,l), sinkCtxtLabel(l).
0.999000::sinkPrim(c,u,l) :- flowPrimPrim(u,v), labelPrim(c,v,l), sinkCtxtLabel(l).

// passthroughs

// base cases
0.999000::transferObjRef(o,c,v)   :- transferRefRef(u,v), pt(c,u,o).
0.999000::transferObjPrim(o,c,v)  :- transferRefPrim(u,v), pt(c,u,o).
// nested entry: behaves like nested escaping
0.999000::transferObjRef(o2,c,v)  :- transferObjRef(o1,c,v), fpt(o1,0,o2).
0.999000::transferObjPrim(o2,c,v) :- transferObjPrim(o1,c,v), fpt(o1,0,o2).

// complete flow

// basic connection of tainting and escaping
0.999000::flow(src,sink) :- sink(o,sink), label(o,src), srcCtxtLabel(src).
0.999000::flow(src,sink) :- sinkPrim(d,u,sink), labelPrim(d,u,src), srcCtxtLabel(src).
// nested escaping (regular and conditional)
0.999000::flow(src,sink) :- sink(o,sink), labelPrimFld(o,t1,src), srcCtxtLabel(src).
0.999000::lflow(sr,sk) :- flow(src,sink), LCL(sr,src), LCL(sk,sink).

// (forward) label flow

// abstract objects
// label introduction
0.999000::labelIn(o,cl)      :- varInLabel(v,l), MV(m,v), reachableCM(c,m), pt(c,v,o), CCL(c,cl), LCL(l,cl).
// nested tainting
0.999000::labelIn(o2,l)      :- labelIn(o1,l), fpt(o1,t1,o2).
0.999000::label(o,l)         :- labelIn(o,l).
// passthrough handling
0.999000::labelXferOut(o2,l) :- label(o1,l), transferObjRef(o1,c,v), pt(c,v,o2).
0.999000::labelXferOut(o,l)  :- labelPrim(c,u,l), transferPrimRef(u,v), pt(c,v,o).
0.999000::label(o,l)         :- labelXferOut(o,l).
// nested passthrough entry
0.999000::labelXferOut(o2,l) :- labelPrimFld(o1,0,l), transferObjRef(o1,c,v), pt(c,v,o2).
// nested passthrough exit
0.999000::labelXferOut(o2,l) :- labelXferOut(o1,l), fpt(o1,0,o2).

// reference-type variables
// labels are tracked on the abstract objects, this is only for convenience
0.999000::labelRef(c,v,l) :- pt(c,v,o), label(o,l).

// primitive-type variables/fields
// label introduction
0.999000::labelPrim(c,v,cl)     :- varInLabelPrim(v,l), reachableCM(c,m), MU(m,v), LCL(l,cl), CCL(c,cl).
// label propagation
0.999000::labelPrim(c,v,l)      :- AssignPrim(v,u), labelPrim(c,u,l).
0.999000::labelPrimFld(o,f,l)   :- labelPrim(c,v,l), StorePrim(u,f,v), pt(c,u,o).
0.999000::labelPrim(c,y,l)      :- LoadPrim(y,x,f), labelPrimFld(o,f,l), pt(c,x,o).
0.999000::labelPrimFldStat(f,l) :- StoreStatPrim(f,v), labelPrim(t1,v,l).
0.999000::labelPrim(c,y,l)      :- LoadStatPrim(y,f), labelPrimFldStat(f,l), MU(m,y), reachableCM(c,m).

0.999000::DUDU(d,u,c,v)    :- CICM(c,i,d,m), MU(m,u), paramPrim(u,v,i).
0.999000::DUDU(c,u,d,v)    :- CICM(c,i,d,m), MU(m,v), returnPrim(u,v,i).
0.999000::labelPrim(d,u,l) :- labelPrim(c,v,l), DUDU(d,u,c,v).

// passthrough handling
0.999000::labelPrim(c,v,l)      :- label(o,l), transferObjPrim(o,c,v).
0.999000::labelPrim(c,v,l)      :- labelPrim(c,u,l), transferPrimPrim(u,v).
// nested tainting
0.999000::labelPrim(c,y,l)      :- LoadPrim(y,x,t1), labelIn(o,l), pt(c,x,o).
// nested passthrough entry
0.999000::labelPrim(c,v,l)      :- labelPrimFld(o,0,l), transferObjPrim(o,c,v).
// nested passthrough exit
0.999000::labelPrim(c,y,l)      :- LoadPrim(y,x,0), labelXferOut(o,l), pt(c,x,o).
