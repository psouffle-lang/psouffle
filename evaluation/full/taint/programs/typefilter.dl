.type V = number
.type C = number
.type H = number
.type T = number
.type M = number
.type Z = number
.type I = number

.decl VT(v:V, t:T)
.input VT

.decl HTFilter(h:H, t:T)
.input HTFilter

.decl CH(o:C, h:H)
.input CH

.decl typeFilter(v:V, o:C)
.output typeFilter

