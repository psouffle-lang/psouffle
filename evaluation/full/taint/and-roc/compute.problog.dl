0.999000::reachablet(T) :- reachablecm(T1, M), mv(M, V), alloc(V, H), ht(H, T).
0.999000::reachablet(T) :- reachablecm(T1, M), statictm(T, M).
0.999000::reachablet(T) :- reachablecm(T1, M), mv(M, V), storestat(F, V), statictf(T, F).
