0.999000::ci_typefilter(V, H) :- vt(V, T), htfilter(H, T).
0.999000::ci_reachablem(0).
0.999000::ci_reachablem(M) :- clinittm(T, M), ci_reachablet(T).
0.999000::ci_reachablem(M) :- ci_im(T1, M).
0.999000::ci_reachablei(I) :- mi(M, I), ci_reachablem(M).
0.999000::ihm(I, H, M2) :- virtim(I, S), dispatch(T, S, M2), ht(H, T).
0.999000::ci_im(I, M) :- ci_reachablei(I), iinvkarg(I, 0, V), ci_pt(V, O), ihm(I, O, M).
0.999000::ci_im(I, M) :- ci_reachablei(I), statim(I, M).
0.999000::ci_im(I, M) :- ci_reachablei(I), iinvkarg(I, 0, V), ci_pt(V, T1), specim(I, M).
0.999000::interprocassign(U, V) :- ci_im(I, M), iinvkarg(I, Z, V), mmetharg(M, Z, U).
0.999000::interprocassign(U, V) :- ci_im(I, M), iinvkret(I, Z, U), mmethret(M, Z, V).
0.999000::ci_pt(U, O) :- interprocassign(U, V), ci_pt(V, O), ci_typefilter(U, O).
0.999000::ci_pt(V, H) :- globalalloc(V, H), mv(M, V), ci_reachablem(M).
0.999000::ci_pt(V, H) :- alloc(V, H), mv(M, V), ci_reachablem(M).
0.999000::ci_pt(V, O) :- ci_pt(U, O), assign(V, U), ci_typefilter(V, O).
0.999000::ci_fpt(O1, F, O2) :- ci_pt(V, O2), store(U, F, V), ci_pt(U, O1).
0.999000::ci_pt(Y, O2) :- ci_pt(X, O1), load(Y, X, F), ci_fpt(O1, F, O2).
0.999000::ci_fptstat(F, O) :- ci_pt(V, O), storestat(F, V).
0.999000::ci_pt(Y, O) :- loadstat(Y, F), ci_fptstat(F, O), mv(M, Y), ci_reachablem(M).
0.999000::ci_reachablet(T) :- ci_reachablem(M), mv(M, V), alloc(V, H), ht(H, T).
0.999000::ci_reachablet(T) :- ci_reachablem(M), statictm(T, M).
0.999000::ci_reachablet(T) :- ci_reachablem(M), mv(M, V), storestat(F, V), statictf(T, F).
0.999000::ci_reachablet(T) :- ci_reachablem(M), mv(M, V), loadstat(V, F), statictf(T, F).
0.999000::ci_reachablet(T) :- classt(T), ci_reachablet(S), subtype(S, T).
0.999000::param(U, V, I) :- ci_im(I, M), mmetharg(M, Z, U), iinvkarg(I, Z, V).
0.999000::return(U, V, I) :- ci_im(I, M), mmethret(M, Z, V), iinvkret(I, Z, U).
0.999000::paramprim(U, V, I) :- ci_im(I, M), mmethprimarg(M, Z, U), iinvkprimarg(I, Z, V).
0.999000::returnprim(U, V, I) :- ci_im(I, M), mmethprimret(M, Z, V), iinvkprimret(I, Z, U).
0.999000::srcctxtlabel(CL) :- lcl(L, CL), srclabel(L).
0.999000::sinkctxtlabel(CL) :- lcl(L, CL), sinklabel(L).
0.999000::typefilter(V, O) :- vt(V, T), htfilter(H, T), ch(O, H).
0.999000::pt(C, V, O) :- assign(V, U), pt(C, U, O), typefilter(V, O).
0.999000::reachableci(C, I) :- mi(M, I), reachablecm(C, M).
0.999000::cic(C, I, D) :- cc(C, D), ci(D, I).
0.852324::dic(C, I, D) :- iinvkarg(I, 0, V), pt(C, V, O), cmap(O, D).
0.800090::cicm(C, I, O, M) :- reachableci(C, I), dic(C, I, O), icm(I, O, M).
0.932564::cicm(C, I, D, M) :- reachableci(C, I), statim(I, M), cic(C, I, D).
0.894051::cicm(C, I, O, M) :- reachableci(C, I), specim(I, M), dic(C, I, O).
0.951946::dvdv(D, U, C, V) :- cicm(C, I, D, M), mv(M, U), param(U, V, I).
0.874632::dvdv(C, U, D, V) :- cicm(C, I, D, M), mv(M, V), return(U, V, I).
0.999000::ctx(C) :- cmap(T1, C).
0.999000::staticm(M) :- statictm(T, M).
0.999000::ipargnonzerovar(V) :- mmetharg(M, I, V), \+(I = 0).
0.999000::ipargstatic0var(V) :- mmetharg(M, 0, V), staticm(M).
0.999000::ipretvar(V) :- iinvkret(I, J, V).
0.999000::ipglobalvar(V) :- ipargnonzerovar(V).
0.999000::ipglobalvar(V) :- ipargstatic0var(V).
0.999000::ipglobalvar(V) :- ipretvar(V).
0.999000::iplocalvar(V) :- mmetharg(M, 0, V), \+staticm(M).
0.999000::ipglobalpair(V, O) :- ipglobalvar(V), typefilter(V, O).
0.999000::iplocalpair(V, O) :- iplocalvar(V), typefilter(V, O).
0.999000::pt(C, U, O) :- dvdv(C, U, D, V), pt(D, V, O), ipglobalpair(U, O), ctx(C).
0.999000::pt(C, U, O) :- dvdv(C, U, D, V), pt(D, V, O), iplocalpair(U, O), cmap(O, C).
0.999000::pt(C, V, O) :- alloc(V, H), mv(M, V), reachablecm(C, M), cc(C, O), ch(O, H).
0.999000::pt(C, V, O) :- globalalloc(V, H), mv(M, V), reachablecm(C, M), ch(O, H).
0.999000::fpt(O1, F, O2) :- pt(C, V, O2), store(U, F, V), pt(C, U, O1).
0.999000::pt(C, Y, O2) :- pt(C, X, O1), load(Y, X, F), fpt(O1, F, O2).
0.999000::fptstat(F, O) :- pt(T1, V, O), storestat(F, V).
0.999000::pt(C, Y, O) :- loadstat(Y, F), fptstat(F, O), mv(M, Y), reachablecm(C, M).
0.999000::reachablet(T) :- reachablecm(T1, M), mv(M, V), alloc(V, H), ht(H, T).
0.999000::reachablet(T) :- reachablecm(T1, M), statictm(T, M).
0.999000::reachablet(T) :- reachablecm(T1, M), mv(M, V), storestat(F, V), statictf(T, F).
0.999000::reachablet(T) :- reachablecm(T1, M), mv(M, V), loadstat(V, F), statictf(T, F).
0.999000::reachablet(T) :- classt(T), reachablet(S), subtype(S, T).
0.999000::reachablecm(0, 0).
0.999000::reachablecm(0, M) :- clinittm(T, M), reachablet(T).
0.999000::reachablecm(C, M) :- cicm(T1, T2, C, M).
0.867116::icm(I, D, M2) :- virtim(I, S), dispatch(T, S, M2), ht(H, T), ch(O, H), cmap(O, D).
0.999000::sink(O, CL) :- varoutlabel(V, L), mv(M, V), reachablecm(C, M), pt(C, V, O), ccl(C, CL), lcl(L, CL).
0.999000::sink(O, L) :- pt(C, U, O), flowrefref(U, V), labelref(C, V, L), sinkctxtlabel(L).
0.999000::sink(O, L) :- pt(C, U, O), flowrefprim(U, V), labelprim(C, V, L), sinkctxtlabel(L).
0.999000::sink(O2, L) :- sink(O1, L), fpt(O1, T1, O2).
0.999000::sinkprim(C, U, CL) :- varoutlabelprim(U, L), reachablecm(C, M), mu(M, U), lcl(L, CL), ccl(C, CL).
0.999000::sinkprim(C, U, L) :- flowprimref(U, V), labelref(C, V, L), sinkctxtlabel(L).
0.999000::sinkprim(C, U, L) :- flowprimprim(U, V), labelprim(C, V, L), sinkctxtlabel(L).
0.999000::transferobjref(O, C, V) :- transferrefref(U, V), pt(C, U, O).
0.999000::transferobjprim(O, C, V) :- transferrefprim(U, V), pt(C, U, O).
0.999000::transferobjref(O2, C, V) :- transferobjref(O1, C, V), fpt(O1, 0, O2).
0.999000::transferobjprim(O2, C, V) :- transferobjprim(O1, C, V), fpt(O1, 0, O2).
0.999000::flow(SRC, SINK) :- sink(O, SINK), label(O, SRC), srcctxtlabel(SRC).
0.999000::flow(SRC, SINK) :- sinkprim(D, U, SINK), labelprim(D, U, SRC), srcctxtlabel(SRC).
0.999000::flow(SRC, SINK) :- sink(O, SINK), labelprimfld(O, T1, SRC), srcctxtlabel(SRC).
0.999000::lflow(SR, SK) :- flow(SRC, SINK), lcl(SR, SRC), lcl(SK, SINK).
0.999000::labelin(O, CL) :- varinlabel(V, L), mv(M, V), reachablecm(C, M), pt(C, V, O), ccl(C, CL), lcl(L, CL).
0.999000::labelin(O2, L) :- labelin(O1, L), fpt(O1, T1, O2).
0.999000::label(O, L) :- labelin(O, L).
0.999000::labelxferout(O2, L) :- label(O1, L), transferobjref(O1, C, V), pt(C, V, O2).
0.999000::labelxferout(O, L) :- labelprim(C, U, L), transferprimref(U, V), pt(C, V, O).
0.999000::label(O, L) :- labelxferout(O, L).
0.999000::labelxferout(O2, L) :- labelprimfld(O1, 0, L), transferobjref(O1, C, V), pt(C, V, O2).
0.999000::labelxferout(O2, L) :- labelxferout(O1, L), fpt(O1, 0, O2).
0.999000::labelref(C, V, L) :- pt(C, V, O), label(O, L).
0.999000::labelprim(C, V, CL) :- varinlabelprim(V, L), reachablecm(C, M), mu(M, V), lcl(L, CL), ccl(C, CL).
0.999000::labelprim(C, V, L) :- assignprim(V, U), labelprim(C, U, L).
0.999000::labelprimfld(O, F, L) :- labelprim(C, V, L), storeprim(U, F, V), pt(C, U, O).
0.999000::labelprim(C, Y, L) :- loadprim(Y, X, F), labelprimfld(O, F, L), pt(C, X, O).
0.999000::labelprimfldstat(F, L) :- storestatprim(F, V), labelprim(T1, V, L).
0.999000::labelprim(C, Y, L) :- loadstatprim(Y, F), labelprimfldstat(F, L), mu(M, Y), reachablecm(C, M).
0.999000::dudu(D, U, C, V) :- cicm(C, I, D, M), mu(M, U), paramprim(U, V, I).
0.999000::dudu(C, U, D, V) :- cicm(C, I, D, M), mu(M, V), returnprim(U, V, I).
0.999000::labelprim(D, U, L) :- labelprim(C, V, L), dudu(D, U, C, V).
0.999000::labelprim(C, V, L) :- label(O, L), transferobjprim(O, C, V).
0.999000::labelprim(C, V, L) :- labelprim(C, U, L), transferprimprim(U, V).
0.999000::labelprim(C, Y, L) :- loadprim(Y, X, T1), labelin(O, L), pt(C, X, O).
0.999000::labelprim(C, V, L) :- labelprimfld(O, 0, L), transferobjprim(O, C, V).
0.999000::labelprim(C, Y, L) :- loadprim(Y, X, 0), labelxferout(O, L), pt(C, X, O).

