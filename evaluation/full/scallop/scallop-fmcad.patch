diff --git a/core/src/common/foreign_functions/band.rs b/core/src/common/foreign_functions/band.rs
new file mode 100644
index 0000000..9beab1d
--- /dev/null
+++ b/core/src/common/foreign_functions/band.rs
@@ -0,0 +1,58 @@
+use super::*;
+
+/// Bitwise-and foreign function (x & y)
+///
+/// ``` scl
+/// extern fn $band<T: Integer>(x: T, y: T) -> T
+/// ```
+#[derive(Clone)]
+pub struct Band;
+
+impl ForeignFunction for Band {
+  fn name(&self) -> String {
+    "band".to_string()
+  }
+
+  fn num_generic_types(&self) -> usize {
+    1
+  }
+
+  fn generic_type_family(&self, i: usize) -> TypeFamily {
+    assert_eq!(i, 0);
+    TypeFamily::Integer
+  }
+
+  fn num_static_arguments(&self) -> usize {
+    2
+  }
+
+  fn static_argument_type(&self, i: usize) -> ForeignFunctionParameterType {
+    match i {
+      0 => ForeignFunctionParameterType::Generic(0),
+      1 => ForeignFunctionParameterType::Generic(0),
+      _ => panic!("No argument {}", i),
+    }
+  }
+
+  fn return_type(&self) -> ForeignFunctionParameterType {
+    ForeignFunctionParameterType::Generic(0)
+  }
+
+  fn execute(&self, args: Vec<Value>) -> Option<Value> {
+    match (&args[0], &args[1]) {
+      (Value::I8(x), Value::I8(y)) => Some(Value::I8(x & y)),
+      (Value::I16(x), Value::I16(y)) => Some(Value::I16(x & y)),
+      (Value::I32(x), Value::I32(y)) => Some(Value::I32(x & y)),
+      (Value::I64(x), Value::I64(y)) => Some(Value::I64(x & y)),
+      (Value::I128(x), Value::I128(y)) => Some(Value::I128(x & y)),
+      (Value::ISize(x), Value::ISize(y)) => Some(Value::ISize(x & y)),
+      (Value::U8(x), Value::U8(y)) => Some(Value::U8(x & y)),
+      (Value::U16(x), Value::U16(y)) => Some(Value::U16(x & y)),
+      (Value::U32(x), Value::U32(y)) => Some(Value::U32(x & y)),
+      (Value::U64(x), Value::U64(y)) => Some(Value::U64(x & y)),
+      (Value::U128(x), Value::U128(y)) => Some(Value::U128(x & y)),
+      (Value::USize(x), Value::USize(y)) => Some(Value::USize(x & y)),
+      _ => panic!("Invalid arguments"),
+    }
+  }
+}
