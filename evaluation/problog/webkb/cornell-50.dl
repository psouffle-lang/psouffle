.decl local(p:symbol, c:symbol)
.decl has_class(p:symbol, c:symbol)
local(P,C) :- word_occ(P,W,C,I), event(I).
has_class(P,C) :- local(P,C).
has_class(P,C) :- link_occ(P,Q,C,D,I), event(I), has_class(Q,D).
.decl q_has_class(x0:symbol, x1:symbol)
q_has_class(X0,X1) :- ask_has_class(X0,X1), has_class(X0,X1).
.output q_has_class
