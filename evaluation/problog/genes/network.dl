.decl mgc_q(x:symbol, y:symbol)
.decl edge_shape(x:symbol, y:symbol)
.decl mgc_path(x:symbol, y:symbol)
.decl e(x:symbol, y:symbol)
.decl path(x:symbol, y:symbol)
.decl q(x:symbol, y:symbol)
edge_shape(X,Y) :- pd_edge(X,Y,_).
edge_shape(X,Y) :- pp_edge(X,Y,_).
edge_shape(Y,X) :- pp_edge(X,Y,_).
mgc_path(X,Y) :- mgc_q(X,Y).
mgc_path(Z,Y) :- mgc_path(X,Y), edge_shape(X,Z).
e(X,Y) :- pd_edge(X,Y,I), event(I).
e(X,Y) :- pp_edge(X,Y,I), event(I).
e(Y,X) :- pp_edge(X,Y,I), event(I).
path(X,Y) :- mgc_path(X,Y), pd_edge(X,Y,I), event(I).
path(X,Y) :- mgc_path(X,Y), e(X,Z), path(Z,Y), X != Y.
q(X,Y) :- mgc_q(X,Y), path(X,Y).
