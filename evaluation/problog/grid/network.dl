.decl source(x:symbol)
.decl target(x:symbol)
target("n_16_16").
.decl relevant(x:symbol)
.decl edge(x:symbol, y:symbol)
.decl reaches(x:symbol)
.decl answer(x:symbol, y:symbol)
relevant(X) :- source(X).
relevant(Y) :- relevant(X), edge_occ(X,Y,_).
edge(X,Y) :- relevant(X), edge_occ(X,Y,I), event(I).
reaches(X) :- edge(X,Y), target(Y).
reaches(X) :- edge(X,Y), reaches(Y).
answer(X,Y) :- source(X), target(Y), reaches(X).
