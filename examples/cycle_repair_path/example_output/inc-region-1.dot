digraph G {
  rankdir=LR;
  "edge(3,4)" [shape=box, penwidth=2, color="#2ca02c"];
  "edge(2,3)" [shape=box, penwidth=2, color="#2ca02c"];
  "edge(1,2)" [shape=box, penwidth=2, color="#2ca02c"];
  "source(0)" [shape=box, penwidth=1, color="black"];
  "edge(3,1)" [shape=box, penwidth=2, color="#2ca02c"];
  "edge(4,5)" [shape=box, penwidth=2, color="#2ca02c"];
  "path(0,0)" [shape=ellipse, penwidth=1, color="black"];
  "edge(0,2)" [shape=box, penwidth=2, color="#2ca02c"];
  "path(0,4)" [shape=ellipse, penwidth=2, color="#2ca02c"];
  "path(0,5)" [shape=ellipse, penwidth=2, color="#2ca02c"];
  "path(0,3)" [shape=ellipse, penwidth=2, color="#2ca02c"];
  "path(0,1)" [shape=ellipse, penwidth=2, color="#2ca02c"];
  "path(0,2)" [shape=ellipse, penwidth=2, color="#2ca02c"];
  "edge_node_6" [shape=point, width=0.2, height=0.2, label="", style=filled, color="black", fillcolor="black", penwidth=1];
  "source(0)" -> "edge_node_6" [color="black", penwidth=1, style=solid];
  "edge_node_6" -> "path(0,0)" [color="black", penwidth=1, style=solid];
  "edge_node_7" [shape=point, width=0.2, height=0.2, label="", style=filled, color="#2ca02c", fillcolor="#2ca02c", penwidth=2];
  "path(0,4)" -> "edge_node_7" [color="#2ca02c", penwidth=2, style=solid];
  "edge(4,5)" -> "edge_node_7" [color="#2ca02c", penwidth=2, style=solid];
  "edge_node_7" -> "path(0,5)" [color="#2ca02c", penwidth=2, style=solid];
  "edge_node_8" [shape=point, width=0.2, height=0.2, label="", style=filled, color="#2ca02c", fillcolor="#2ca02c", penwidth=2];
  "path(0,3)" -> "edge_node_8" [color="#2ca02c", penwidth=2, style=solid];
  "edge(3,4)" -> "edge_node_8" [color="#2ca02c", penwidth=2, style=solid];
  "edge_node_8" -> "path(0,4)" [color="#2ca02c", penwidth=2, style=solid];
  "edge_node_9" [shape=point, width=0.2, height=0.2, label="", style=filled, color="#2ca02c", fillcolor="#2ca02c", penwidth=2];
  "path(0,3)" -> "edge_node_9" [color="#2ca02c", penwidth=2, style=solid];
  "edge(3,1)" -> "edge_node_9" [color="#2ca02c", penwidth=2, style=solid];
  "edge_node_9" -> "path(0,1)" [color="#2ca02c", penwidth=2, style=solid];
  "edge_node_10" [shape=point, width=0.2, height=0.2, label="", style=filled, color="#2ca02c", fillcolor="#2ca02c", penwidth=2];
  "path(0,2)" -> "edge_node_10" [color="#2ca02c", penwidth=2, style=solid];
  "edge(2,3)" -> "edge_node_10" [color="#2ca02c", penwidth=2, style=solid];
  "edge_node_10" -> "path(0,3)" [color="#2ca02c", penwidth=2, style=solid];
  "edge_node_11" [shape=point, width=0.2, height=0.2, label="", style=filled, color="#2ca02c", fillcolor="#2ca02c", penwidth=2];
  "path(0,1)" -> "edge_node_11" [color="#2ca02c", penwidth=2, style=solid];
  "edge(1,2)" -> "edge_node_11" [color="#2ca02c", penwidth=2, style=solid];
  "edge_node_11" -> "path(0,2)" [color="#2ca02c", penwidth=2, style=solid];
  "edge_node_12" [shape=point, width=0.2, height=0.2, label="", style=filled, color="#2ca02c", fillcolor="#2ca02c", penwidth=2];
  "path(0,0)" -> "edge_node_12" [color="#2ca02c", penwidth=2, style=solid];
  "edge(0,2)" -> "edge_node_12" [color="#2ca02c", penwidth=2, style=solid];
  "edge_node_12" -> "path(0,2)" [color="#2ca02c", penwidth=2, style=solid];
  subgraph cluster_legend {
    label="Legend";
    color=gray;
    legend_fact [shape=box, label="Fact node"];
    legend_derived [shape=ellipse, label="Derived node"];
    legend_region [shape=ellipse, penwidth=2, color="#1f77b4", label="Region member"];
    legend_boundary [shape=ellipse, penwidth=2, color="#ff7f0e", label="Boundary head"];
    legend_delta_node [shape=ellipse, penwidth=2, color="#2ca02c", label="Delta node"];
    legend_anchor_node [shape=box, penwidth=2, color="#f2c744", label="Mergeable node anchor"];
    legend_src_region [shape=box, label="Sample fact"];
    legend_dst_region [shape=ellipse, label="Sample head"];
    legend_hyper_region [shape=point, width=0.2, height=0.2, label="", style=filled, color="#1f77b4", fillcolor="#1f77b4"];
    legend_src_region -> legend_hyper_region [color="#1f77b4", penwidth=2, label="region hyperedge"];
    legend_hyper_region -> legend_dst_region [color="#1f77b4", penwidth=2];
    legend_src_delta [shape=box, label="Sample fact"];
    legend_dst_delta [shape=ellipse, label="Sample head"];
    legend_hyper_delta [shape=point, width=0.2, height=0.2, label="", style=filled, color="#2ca02c", fillcolor="#2ca02c"];
    legend_src_delta -> legend_hyper_delta [color="#2ca02c", penwidth=2, label="delta hyperedge"];
    legend_hyper_delta -> legend_dst_delta [color="#2ca02c", penwidth=2];
    legend_src_merge [shape=box, label="Sample fact"];
    legend_dst_merge [shape=ellipse, label="Sample head"];
    legend_hyper_merge [shape=point, width=0.2, height=0.2, label="", style=filled, color="red", fillcolor="red"];
    legend_src_merge -> legend_hyper_merge [color="red", penwidth=2, label="mergeable anchor path"];
    legend_hyper_merge -> legend_dst_merge [color="red", penwidth=2];
  }
}
